# Variables d'environnement pour le serveur MCP Hermes
# Copie ce fichier en .env et remplis tes valeurs

# URL de base de ton agent Hermes (sans slash final)
HERMES_BASE_URL=https://workspace.srv1570727.hstgr.cloud

# Clé API Bearer pour authentifier les requêtes vers Hermes
HERMES_API_KEY=REMPLACE_PAR_TA_API_KEY

# Nom du modèle Hermes à utiliser
HERMES_MODEL=hermes

# Port d'écoute du serveur MCP SSE (doit matcher la config Nginx)
PORT=3001

# Secret partagé pour protéger l'endpoint /mcp-sse depuis l'extérieur
# Génère-en un avec: openssl rand -hex 32
MCP_SECRET=REMPLACE_PAR_UN_SECRET_FORT
